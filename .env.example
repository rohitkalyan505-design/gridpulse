# ==============================================================================
# GridPulse — Environment Configuration Template
# ==============================================================================
# WARNING: This file contains configuration placeholders ONLY.
# NEVER commit real API keys, passwords, private keys, or credentials to git.
# Copy this file to .env.local for local development.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION ENVIRONMENT (Client & Server)
# ------------------------------------------------------------------------------
# Base URL for the GridPulse web application
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Environment stage: development | staging | production
NEXT_PUBLIC_APP_ENV=development

# ------------------------------------------------------------------------------
# 2. FIREBASE CLIENT CONFIGURATION (Public / Client-Safe)
# ------------------------------------------------------------------------------
# Used by Firebase Web SDK for Authentication and Cloud Firestore client access.
# These values are baked into the client bundle and exposed to the browser.
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_web_api_key_placeholder
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=gridpulse-dev.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=gridpulse-dev
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=gridpulse-dev.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id_placeholder
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id_placeholder

# ------------------------------------------------------------------------------
# 3. FIREBASE ADMIN / SERVER CONFIGURATION (Server-Only Secret)
# ------------------------------------------------------------------------------
# Used by Firebase Admin SDK on the Next.js server runtime for privileged operations.
# NEVER expose these variables with NEXT_PUBLIC_ prefix.
FIREBASE_PROJECT_ID=gridpulse-dev
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@gridpulse-dev.iam.gserviceaccount.com
# Private key should be escaped (newlines as \n) or base64 encoded
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# ------------------------------------------------------------------------------
# 4. SUPABASE STORAGE CONFIGURATION (File Storage ONLY)
# ------------------------------------------------------------------------------
# IMPORTANT ARCHITECTURAL RULE:
# Supabase is used EXCLUSIVELY for File Storage (documents, telemetry blobs, exports).
# Supabase is NOT the application database (Firestore is the application database).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_public_key_placeholder
# Server-only service role key for backend file management
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_placeholder
SUPABASE_STORAGE_BUCKET=gridpulse-telemetry-storage

# ------------------------------------------------------------------------------
# 5. AI ENGINE CONFIGURATION (Server-Only Secrets)
# ------------------------------------------------------------------------------
# Primary inference engine: Groq (ultra-low latency structured reasoning & summarization)
GROQ_API_KEY=your_groq_api_key_placeholder
# Secondary inference engine: Gemini (multimodal analysis & complex synthesis)
GEMINI_API_KEY=your_gemini_api_key_placeholder

# ------------------------------------------------------------------------------
# 6. SCIENTIFIC SERVICE CONFIGURATION (Server-Only)
# ------------------------------------------------------------------------------
# Endpoint and authentication for the Python/FastAPI deterministic scientific engine
SCIENTIFIC_SERVICE_URL=http://localhost:8000
SCIENTIFIC_SERVICE_API_KEY=your_scientific_service_shared_secret_placeholder
